#define ZMK_POINTING_DEFAULT_MOVE_VAL 800
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <zmk-helpers/key-labels/42.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/glove80.h"
#include "zmk-helpers/unicode-chars/german.dtsi"

/* Layer numbers are part of the persisted ZMK keymap state. */
#define L_BASE 0
#define L_NAV 1
#define L_MOUSE 2
#define L_MEDIA 3
#define L_NUM 4
#define L_SYM 5
#define L_FUN 6
#define L_HOST 7
#define L_GAME 8
#define L_ADJUST 9

&sk {
    release-after-ms = <1000>;
    quick-release;
    lazy;
    ignore-modifiers;
};

&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

&lt {
    tapping-term-ms = <220>;
    flavor = "tap-preferred";
    quick-tap-ms = <180>;
};

/ {
    behaviors {
        hml: home_row_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <
                6 7 8 9 10 11
                18 19 20 21 22 23
                30 31 32 33 34 35
                39 40 41
            >;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hmr: home_row_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <
                0 1 2 3 4 5
                12 13 14 15 16 17
                24 25 26 27 28 29
                36 37 38
            >;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        host_combo {
            timeout-ms = <80>;
            key-positions = <0 11>;
            layers = <L_BASE>;
            bindings = <&mo L_HOST>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <L_NAV L_NUM>;
            then-layer = <L_ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            label = "BASE";
            display-name = "BASE";
            /* Colemak-DH, symmetric HRM, and thumb layer-taps. */
            bindings = <
                &kp ESCAPE       &kp Q              &kp W              &kp F              &kp P              &kp B
                &kp J            &kp L              &kp U              &kp Y              &kp SQT            &kp BACKSPACE
                &kp TAB          &hml LMETA A       &hml LEFT_ALT R     &hml LCTRL S        &hml LEFT_SHIFT T   &kp G
                &kp M            &hmr RIGHT_SHIFT N &hmr RCTRL E        &hmr RIGHT_ALT I    &hmr RIGHT_GUI O   &kp SEMICOLON
                &sk LSHFT        &kp Z              &kp X              &kp C              &kp D              &kp V
                &kp K            &kp H              &kp COMMA           &kp DOT            &kp SLASH          &kp RIGHT_SHIFT
                &lt L_MEDIA ESCAPE &lt L_NAV SPACE   &lt L_MOUSE TAB    &lt L_SYM ENTER     &lt L_NUM BACKSPACE &lt L_FUN DELETE
            >;
        };

        NAV {
            label = "NAV";
            display-name = "NAV";
            bindings = <
                &trans           &trans             &trans             &trans             &trans             &trans
                &kp LS(LG(Z))    &kp LG(V)          &kp LG(C)          &kp LG(X)          &kp LG(Z)          &trans
                &trans           &kp LGUI           &kp LALT           &kp LCTRL          &kp LEFT_SHIFT    &to L_GAME
                &kp CAPS         &kp LEFT           &kp DOWN_ARROW     &kp UP_ARROW      &kp RIGHT         &kp K_CONTEXT_MENU
                &trans           &trans             &trans             &trans             &trans             &trans
                &kp INSERT       &kp HOME           &kp PAGE_DOWN      &kp PAGE_UP       &kp END           &trans
                &trans           &trans             &trans             &trans             &trans             &trans
            >;
        };

        MOUSE {
            label = "MOUSE";
            display-name = "MOUSE";
            bindings = <
                &none            &msc SCRL_LEFT     &msc SCRL_DOWN     &msc SCRL_UP       &msc SCRL_RIGHT    &none
                &none            &none              &none              &none              &none              &none
                &none            &none              &none              &none              &none              &none
                &mkp MB5         &mkp MB1           &mkp MB2           &mkp MB3           &mkp MB4           &mkp MCLK
                &none            &none              &none              &none              &none              &none
                &mmv MOVE_LEFT   &mmv MOVE_DOWN     &mmv MOVE_UP        &mmv MOVE_RIGHT    &none              &none
                &none            &none              &none              &none              &none              &none
            >;
        };

        MEDIA {
            label = "MEDIA";
            display-name = "MEDIA";
            bindings = <
                &none            &none              &none              &none              &none              &none
                &kp K_PREV       &kp K_VOLUME_DOWN   &kp K_VOLUME_UP     &kp K_NEXT          &none              &none
                &none            &none              &none              &none              &none              &none
                &kp K_STOP       &kp K_PLAY_PAUSE    &kp K_MUTE           &none              &none              &none
                &none            &none              &none              &none              &none              &none
                &none            &none              &none              &none              &none              &none
                &none            &none              &none              &none              &none              &none
            >;
        };

        NUM {
            label = "NUM";
            display-name = "NUM";
            bindings = <
                &none            &kp LEFT_BRACKET   &kp NUMBER_7        &kp NUMBER_8        &kp NUMBER_9        &kp RIGHT_BRACKET
                &kp PERIOD       &kp NUMBER_0       &kp MINUS           &none              &none              &none
                &none            &kp SEMICOLON       &kp NUMBER_4        &kp NUMBER_5        &kp NUMBER_6        &kp EQUAL
                &none            &none              &none              &none              &none              &none
                &none            &kp GRAVE           &kp NUMBER_1        &kp NUMBER_2        &kp NUMBER_3        &kp BACKSLASH
                &none            &none              &none              &none              &none              &none
                &trans           &trans              &trans              &trans              &trans              &trans
            >;
        };

        SYM {
            label = "SYM";
            display-name = "SYM";
            bindings = <
                &none            &kp GRAVE           &kp AMPERSAND       &kp ASTERISK        &kp LEFT_BRACE      &kp RIGHT_BRACE
                &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none              &none
                &none            &kp COLON           &kp DOLLAR          &kp PERCENT         &kp CARET          &kp EQUAL
                &kp SLASH        &kp RIGHT_SHIFT     &kp RCTRL           &kp RIGHT_ALT       &kp RIGHT_GUI      &none
                &none            &kp TILDE           &kp EXCLAMATION     &kp AT_SIGN        &kp HASH           &kp PIPE
                &kp BACKSLASH    &none              &none              &none              &none              &none
                &kp LESS_THAN    &kp GREATER_THAN    &kp MINUS           &trans              &trans              &trans
            >;
        };

        FUN {
            label = "FUN";
            display-name = "FUN";
            bindings = <
                &none            &kp F12             &kp F7              &kp F8              &kp F9              &none
                &none            &none              &none              &none              &none              &none
                &none            &kp F11             &kp F4              &kp F5              &kp F6              &none
                &none            &none              &none              &none              &none              &none
                &none            &kp F10             &kp F1              &kp F2              &kp F3              &none
                &none            &none              &none              &none              &none              &none
                &trans           &trans              &trans              &trans              &trans              &trans
            >;
        };

        HOST {
            label = "HOST";
            display-name = "HOST";
            /* Hold BASE outer ESC + BACKSPACE; F13-F20 bridge to AeroSpace. */
            bindings = <
                &none            &kp F13            &kp F14            &kp F15            &kp F16            &kp F17
                &kp LA(J)        &kp LA(L)           &kp F18            &kp F19            &kp F20            &none
                &none            &none              &none              &none              &none              &none
                &none            &none              &none              &none              &none              &none
                &none            &none              &none              &none              &none              &none
                &kp LA(K)        &kp LA(H)           &none              &none              &none              &none
                &none            &none              &none              &none              &none              &none
            >;
        };

        GAME {
            label = "GAME";
            display-name = "GAME";
            /* Deterministic tap-only QWERTY layer; right thumb exits to BASE. */
            bindings = <
                &kp ESCAPE       &kp GRAVE           &kp NUMBER_1        &kp NUMBER_2        &kp NUMBER_3        &kp NUMBER_4
                &kp NUMBER_5     &kp NUMBER_6        &kp NUMBER_7        &kp NUMBER_8        &kp NUMBER_9        &kp BACKSPACE
                &kp TAB          &kp Q               &kp W               &kp E               &kp R               &kp T
                &kp Y            &kp U               &kp I               &kp O               &kp P               &kp ENTER
                &kp LEFT_SHIFT   &kp A               &kp S               &kp D               &kp F               &kp G
                &kp H            &kp J               &kp K               &kp L               &kp SEMICOLON       &kp RIGHT_SHIFT
                &kp LCTRL        &kp LALT            &kp SPACE            &kp ENTER           &kp RALT            &to L_BASE
            >;
        };

        ADJUST {
            label = "ADJUST";
            display-name = "ADJUST";
            /* NAV + NUM only: keep destructive/admin actions out of daily layers. */
            bindings = <
                &none            &bootloader         &sys_reset         &bt BT_CLR         &out OUT_TOG       &ext_power EP_TOG
                &bt BT_SEL 0     &bt BT_SEL 1        &bt BT_SEL 2       &bt BT_SEL 3       &none              &none
                &none            &none               &none              &none              &none              &none
                &none            &none               &none              &none              &none              &none
                &none            &none               &none              &none              &none              &none
                &none            &none               &none              &none              &none              &none
                &none            &none               &none              &none              &none              &none
            >;
        };
    };
};
