# Canonical Ghostty terminal configuration for Corne / AeroSpace workflow.
# Install this file at ~/.config/ghostty/config; see docs/macos-aerospace.md.

# Quick Terminal (dropdown/scratch terminal)
# Global toggle shortcut: Ctrl+`
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Quick Terminal appearance & behavior
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0
quick-terminal-autohide = true
