{
  "title": "Corne Semantic Editing Bridge (F21-F24)",
  "rules": [
    {
      "description": "Corne F21-F24 Semantic Editing (F21=Cmd+C, F22=Cmd+V, F23=Cmd+X, F24=Cmd+Z, Shift+F24=Cmd+Shift+Z)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "f24",
            "modifiers": {
              "mandatory": ["shift"],
              "optional": ["caps_lock"]
            }
          },
          "to": [
            {
              "key_code": "z",
              "modifiers": ["left_command", "left_shift"]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "f24",
            "modifiers": {
              "optional": ["caps_lock"]
            }
          },
          "to": [
            {
              "key_code": "z",
              "modifiers": ["left_command"]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "f21",
            "modifiers": {
              "optional": ["caps_lock"]
            }
          },
          "to": [
            {
              "key_code": "c",
              "modifiers": ["left_command"]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "f22",
            "modifiers": {
              "optional": ["caps_lock"]
            }
          },
          "to": [
            {
              "key_code": "v",
              "modifiers": ["left_command"]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "f23",
            "modifiers": {
              "optional": ["caps_lock"]
            }
          },
          "to": [
            {
              "key_code": "x",
              "modifiers": ["left_command"]
            }
          ]
        }
      ]
    }
  ]
}
